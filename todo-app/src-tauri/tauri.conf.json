{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TodoApp",
  "version": "1.0.0",
  "identifier": "com.todocalendar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "待办日历",
        "width": 380,
        "height": 480,
        "minWidth": 340,
        "minHeight": 400,
        "transparent": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
